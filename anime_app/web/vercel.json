{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy",
      "NPM_CONFIG_LOGLEVEL": "error"
    }
  },
  "functions": {
    "api/**/*.py": {
      "includeFiles": "api/*.db*"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
