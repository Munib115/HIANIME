{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "api/hianime.db",
      "maxDuration": 60
    },
    "api/*.py": {
      "includeFiles": "api/hianime.db",
      "maxDuration": 60
    },
    "api/**/*.py": {
      "includeFiles": "api/hianime.db",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
