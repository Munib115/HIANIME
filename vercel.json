{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy",
      "NPM_CONFIG_LOGLEVEL": "error"
    }
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "api/*.{db*,json.gz,npz,html}",
      "maxDuration": 60
    },
    "api/*.py": {
      "includeFiles": "api/*.{db*,json.gz,npz,html}",
      "maxDuration": 60
    },
    "api/**/*.py": {
      "includeFiles": "api/*.{db*,json.gz,npz,html}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/sitemap-:part.xml"
    },
    {
      "source": "/anime/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/watch/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/genre/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dubbed",
      "destination": "/api/index.py"
    },
    {
      "source": "/airing",
      "destination": "/api/index.py"
    },
    {
      "source": "/advisor",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
